import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, ThemeMode } from "theme.slint";
import { Strings } from "strings.slint";
import { SField } from "components/field.slint";
import { SSelect } from "components/select.slint";
import { SSwitch } from "components/switch.slint";
import { SProgress } from "components/progress.slint";

import { SButton } from "components/button.slint";

export { Theme, ThemeMode, Strings }

// Host-side handling of data dropped from other applications.
export global DropApi {
    pure callback can-drop(data-transfer) -> bool;
    callback dropped(data-transfer);
}

export struct CategoryItem {
    // Empty key = "all tools".
    key: string,
    count: int,
}

export struct ToolItem {
    id: string,
    name: string,
    description: string,
}

// One generated parameter field. `kind` is bool | int | float | text | choice.
export struct FormField {
    id: string,
    label: string,
    kind: string,
    text: string,
    checked: bool,
    index: int,
    options: [string],
    hint: string,
    error: string,
}

component FormRow inherits VerticalLayout {
    in property <FormField> field;
    callback edited(string);
    callback toggled(bool);
    callback selected(int);

    max-width: 440px;
    spacing: 4px;

    if root.field.kind != "bool": HorizontalLayout {
        Text {
            text: root.field.label;
            color: Theme.text;
            font-size: Theme.fs-base;
            font-weight: 600;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: root.field.hint;
            color: Theme.text-3;
            font-family: Theme.mono;
            font-size: Theme.fs-small;
        }
    }

    if root.field.kind == "bool": SSwitch {
        text: root.field.label;
        checked: root.field.checked;
        toggled(value) => { root.toggled(value); }
    }

    if root.field.kind == "int" || root.field.kind == "float": SField {
        mono: true;
        text: root.field.text;
        edited(value) => { root.edited(value); }
    }

    if root.field.kind == "text": SField {
        text: root.field.text;
        edited(value) => { root.edited(value); }
    }

    if root.field.kind == "choice": SSelect {
        model: root.field.options;
        current-index: root.field.index;
        selected(index) => { root.selected(index); }
    }

    if root.field.error != "": Text {
        text: root.field.error;
        color: Theme.error;
        font-size: Theme.fs-small;
        wrap: word-wrap;
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> selected;
    callback clicked();

    height: 32px;
    background: area.has-hover ? Theme.raised : transparent;
    animate background { duration: Theme.anim; easing: ease-out; }

    // Selection marker: a bar on the left.
    Rectangle {
        x: 0;
        width: 3px;
        background: Theme.text;
        visible: root.selected;
    }

    Text {
        x: 16px;
        width: parent.width - 64px;
        height: parent.height;
        text: root.label;
        color: Theme.text;
        font-size: Theme.fs-base;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 44px;
        width: 32px;
        height: parent.height;
        text: root.count;
        color: Theme.text-2;
        font-family: Theme.mono;
        font-size: Theme.fs-small;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ToolRow inherits Rectangle {
    in property <ToolItem> tool;
    in property <bool> selected;
    callback clicked();

    height: 52px;
    background: area.has-hover ? Theme.surface : transparent;
    animate background { duration: Theme.anim; easing: ease-out; }

    Rectangle {
        x: 0;
        width: 3px;
        background: Theme.text;
        visible: root.selected;
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 12px;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.tool.name;
            color: Theme.text;
            font-size: Theme.fs-base;
            font-weight: root.selected ? 600 : 400;
            overflow: elide;
        }

        Text {
            text: root.tool.description;
            color: Theme.text-2;
            font-size: Theme.fs-small;
            overflow: elide;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.divider;
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Sundry";
    min-width: 760px;
    min-height: 480px;
    preferred-width: 1040px;
    preferred-height: 680px;
    background: Theme.bg;
    default-font-size: Theme.fs-base;

    in property <[CategoryItem]> categories;
    in property <[ToolItem]> tools;
    in property <int> tool-total;
    in-out property <string> selected-category: "";
    in-out property <string> query: "";
    in-out property <ToolItem> current-tool;
    in-out property <bool> has-current-tool: false;
    in-out property <int> theme-index: 0;
    in property <[FormField]> form;
    in property <bool> form-valid: true;
    in-out property <string> input-text: "";
    in property <[string]> input-files;
    in property <bool> running: false;
    in property <float> progress: 0;
    in property <string> result-text: "";
    in property <bool> result-error: false;

    callback category-selected(string);
    callback search-edited(string);
    callback tool-selected(ToolItem);
    callback theme-selected(int);
    callback field-edited(int, string);
    callback field-toggled(int, bool);
    callback field-selected(int, int);
    callback file-removed(int);
    callback files-cleared();
    callback run-requested();
    callback cancel-requested();

    // Ctrl+K focuses the search field.
    scope := FocusScope {
        key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && event.text == "k") {
                search.focus-input();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                // Categories
                Rectangle {
                    width: 200px;
                    background: Theme.surface;

                    VerticalLayout {
                        padding-top: 12px;
                        alignment: start;

                        Text {
                            text: "Sundry";
                            color: Theme.text;
                            font-size: Theme.fs-title;
                            font-weight: 600;
                            height: 40px;
                            x: 16px;
                            vertical-alignment: center;
                        }

                        for category in root.categories: NavItem {
                            label: Strings.category(category.key);
                            count: category.count;
                            selected: category.key == root.selected-category;
                            clicked => {
                                root.selected-category = category.key;
                                root.category-selected(category.key);
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.divider;
                }

                // Search, tool list and details
                VerticalLayout {
                    Rectangle {
                        height: 56px;

                        search := SField {
                            x: 16px;
                            y: 12px;
                            width: min(parent.width - 32px, 480px);
                            height: 32px;
                            placeholder: @tr("Search tools (Ctrl+K)");
                            text <=> root.query;
                            edited(value) => { root.search-edited(value); }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;

                        Rectangle {
                            width: 320px;

                            if root.tools.length == 0: Text {
                                x: 16px;
                                y: 16px;
                                width: parent.width - 32px;
                                wrap: word-wrap;
                                color: Theme.text-2;
                                text: root.tool-total == 0
                                    ? @tr("No tools are registered yet.")
                                    : @tr("No tools match your search.");
                            }

                            ListView {
                                width: parent.width;
                                height: parent.height;
                                for item in root.tools: ToolRow {
                                    tool: item;
                                    selected: root.has-current-tool && item.id == root.current-tool.id;
                                    clicked => {
                                        root.current-tool = item;
                                        root.has-current-tool = true;
                                        root.tool-selected(item);
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: 1px;
                            background: Theme.divider;
                        }

                        Rectangle {
                            // Accepts files dragged in from the file manager.
                            drop := DropArea {
                                can-drop(event) => {
                                    DropApi.can-drop(event.data) ? DragAction.copy : DragAction.none
                                }
                                dropped(event) => {
                                    DropApi.dropped(event.data);
                                    return event.proposed-action;
                                }
                            }

                            VerticalLayout {
                                padding: 24px;
                                spacing: 8px;

                                if root.has-current-tool: Text {
                                    text: root.current-tool.name;
                                    color: Theme.text;
                                    font-size: Theme.fs-title;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }

                                if root.has-current-tool: Text {
                                    text: root.current-tool.description;
                                    color: Theme.text-2;
                                    font-size: Theme.fs-medium;
                                    wrap: word-wrap;
                                }

                                if root.has-current-tool: Text {
                                    text: root.current-tool.id;
                                    color: Theme.text-3;
                                    font-family: Theme.mono;
                                    font-size: Theme.fs-small;
                                }

                                if root.has-current-tool: ScrollView {
                                    vertical-stretch: 1;

                                    VerticalLayout {
                                        padding-top: 8px;
                                        padding-bottom: 8px;
                                        spacing: 16px;
                                        alignment: start;

                                        for item[index] in root.form: FormRow {
                                            field: item;
                                            edited(value) => { root.field-edited(index, value); }
                                            toggled(value) => { root.field-toggled(index, value); }
                                            selected(choice) => { root.field-selected(index, choice); }
                                        }

                                        VerticalLayout {
                                            max-width: 440px;
                                            spacing: 4px;

                                            HorizontalLayout {
                                                Text {
                                                    text: @tr("Input");
                                                    color: Theme.text;
                                                    font-size: Theme.fs-base;
                                                    font-weight: 600;
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }

                                                if root.input-files.length > 0: Text {
                                                    text: @tr("Clear files");
                                                    color: Theme.text-2;
                                                    font-size: Theme.fs-small;

                                                    TouchArea {
                                                        clicked => { root.files-cleared(); }
                                                    }
                                                }
                                            }

                                            SField {
                                                placeholder: @tr("Type text, or drop files on this panel");
                                                text <=> root.input-text;
                                            }

                                            for file[index] in root.input-files: HorizontalLayout {
                                                spacing: 8px;

                                                Text {
                                                    text: file;
                                                    color: Theme.text-2;
                                                    font-family: Theme.mono;
                                                    font-size: Theme.fs-small;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }

                                                SButton {
                                                    width: 72px;
                                                    height: 24px;
                                                    min-height: 24px;
                                                    text: @tr("Remove");
                                                    clicked => { root.file-removed(index); }
                                                }
                                            }
                                        }

                                        if root.result-text != "": VerticalLayout {
                                            spacing: 4px;

                                            Text {
                                                text: @tr("Result");
                                                color: Theme.text;
                                                font-size: Theme.fs-base;
                                                font-weight: 600;
                                            }

                                            // Read-only input: the result can be selected and copied.
                                            TextInput {
                                                text: root.result-text;
                                                read-only: true;
                                                wrap: word-wrap;
                                                color: root.result-error ? Theme.error : Theme.text;
                                                font-family: Theme.mono;
                                                font-size: Theme.fs-base;
                                                selection-background-color: Theme.text;
                                                selection-foreground-color: Theme.bg;
                                            }
                                        }
                                    }
                                }

                                if root.has-current-tool: HorizontalLayout {
                                    alignment: start;

                                    SButton {
                                        width: 96px;
                                        text: @tr("Run");
                                        primary: true;
                                        enabled: root.form-valid && !root.running;
                                        clicked => { root.run-requested(); }
                                    }
                                }

                                if !root.has-current-tool: Text {
                                    text: @tr("Select a tool from the list.");
                                    color: Theme.text-2;
                                }

                                if !root.has-current-tool: Rectangle {
                                    vertical-stretch: 1;
                                }
                            }

                            if drop.has-drag: Rectangle {
                                background: Theme.bg.with-alpha(0.9);
                                border-width: 2px;
                                border-color: Theme.text;

                                Text {
                                    text: @tr("Drop files here");
                                    color: Theme.text;
                                    font-size: Theme.fs-medium;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            // Status bar: tool count, progress of the running tool, theme
            Rectangle {
                height: 40px;
                background: Theme.surface;

                Text {
                    x: 16px;
                    height: parent.height;
                    text: @tr("{n} tool" | "{n} tools" % root.tool-total);
                    color: Theme.text-2;
                    font-size: Theme.fs-small;
                    vertical-alignment: center;
                }

                if root.running: HorizontalLayout {
                    x: 160px;
                    width: parent.width - 160px - 188px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;

                        SProgress {
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            value: root.progress;
                        }
                    }

                    Text {
                        width: 40px;
                        text: round(root.progress * 100) + "%";
                        color: Theme.text-2;
                        font-family: Theme.mono;
                        font-size: Theme.fs-small;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    SButton {
                        width: 80px;
                        height: 28px;
                        min-height: 28px;
                        text: @tr("Cancel");
                        clicked => { root.cancel-requested(); }
                    }
                }

                SSelect {
                    x: parent.width - self.width - 16px;
                    y: (parent.height - self.height) / 2;
                    width: 140px;
                    height: 28px;
                    min-height: 28px;
                    open-up: true;
                    model: [@tr("Theme: system"), @tr("Theme: light"), @tr("Theme: dark")];
                    current-index <=> root.theme-index;
                    selected(index) => {
                        Theme.mode = index == 1 ? ThemeMode.light
                            : index == 2 ? ThemeMode.dark : ThemeMode.system;
                        root.theme-selected(index);
                    }
                }
            }
        }
    }

    init => {
        scope.focus();
    }
}
