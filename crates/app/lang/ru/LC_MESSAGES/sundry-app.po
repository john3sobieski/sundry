msgid "Image metadata"
msgstr "Метаданные изображения"

msgid "Shows everything a picture file carries (EXIF, GPS, XMP, IPTC, colour profile, comments) in detail and removes only the selected parts. The picture itself is not re-encoded, so nothing is lost. Removal works for JPEG, PNG and WebP."
msgstr "Подробно показывает всё, что хранится в файле картинки (EXIF, GPS, XMP, IPTC, цветовой профиль, комментарии), и удаляет только выбранное. Сама картинка не перекодируется, поэтому качество не страдает. Удаление работает для JPEG, PNG и WebP."

msgid "What to remove"
msgstr "Что удалить"

msgid "GPS location"
msgstr "Геолокация (GPS)"

msgid "Dates and times"
msgstr "Даты и время"

msgid "Camera, lens and software"
msgstr "Камера, объектив и программа"

msgid "Author, owner and description"
msgstr "Автор, владелец и описание"

msgid "Shooting settings (exposure, ISO, flash)"
msgstr "Параметры съёмки (выдержка, ISO, вспышка)"

msgid "Embedded thumbnail"
msgstr "Встроенная миниатюра"

msgid "MakerNote (vendor data)"
msgstr "MakerNote (данные производителя)"

msgid "Other EXIF fields"
msgstr "Прочие поля EXIF"

