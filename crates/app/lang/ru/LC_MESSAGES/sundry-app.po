msgid "Colour profile (changes colours)"
msgstr "Цветовой профиль (меняет цвета)"

msgid "Rotation flag (changes how the picture is shown)"
msgstr "Флаг поворота (меняет отображение картинки)"

msgid "Also remove these EXIF tags (names or 0x numbers, comma separated)"
msgstr "Дополнительно удалить EXIF-теги (имена или 0x-номера через запятую)"

msgid "View metadata"
msgstr "Посмотреть метаданные"

msgid "Remove metadata"
msgstr "Удалить метаданные"

msgid "Privacy (recommended)"
msgstr "Приватность (рекомендуется)"

msgid "Everything (except colour profile and rotation)"
msgstr "Всё (кроме цветового профиля и поворота)"

msgid "Custom selection"
msgstr "Свой выбор"

