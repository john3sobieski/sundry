// Design tokens. Values come from PROGRESS.md ("UI style"); change them there first.
import { Palette } from "std-widgets.slint";

export enum ThemeMode { system, light, dark }

export global Theme {
    in-out property <ThemeMode> mode: ThemeMode.system;
    // `Palette.color-scheme` follows the OS when no scheme is forced.
    out property <bool> dark: mode == ThemeMode.dark
        || (mode == ThemeMode.system && Palette.color-scheme == ColorScheme.dark);

    out property <color> bg: dark ? #000000 : #FFFFFF;
    out property <color> surface: dark ? #0A0A0A : #F5F5F5;
    out property <color> raised: dark ? #141414 : #FFFFFF;
    out property <color> text: dark ? #EDEDED : #0A0A0A;
    out property <color> text-2: dark ? #A3A3A3 : #525252;
    out property <color> text-3: dark ? #8A8A8A : #737373;
    out property <color> divider: dark ? #262626 : #E0E0E0;
    out property <color> control-border: dark ? #666666 : #8A8A8A;
    out property <color> success: dark ? #3FB950 : #1A7F37;
    out property <color> warning: dark ? #D29922 : #9A6700;
    out property <color> error: dark ? #F85149 : #CF222E;

    out property <length> radius: 4px;
    out property <length> fs-small: 12px;
    out property <length> fs-base: 13px;
    out property <length> fs-medium: 15px;
    out property <length> fs-title: 20px;
    // Monospace gives tabular digits: `Text` has no font-feature property.
    out property <string> mono: "Consolas";

    out property <duration> anim: 120ms;
}
