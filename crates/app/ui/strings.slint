// All user-visible text goes through @tr() so it can be translated (see lang/).
// Rust code never builds user-facing text: it passes codes and values to these functions.
export global Strings {
    pure public function category(key: string) -> string {
        if (key == "") { return @tr("All tools"); }
        if (key == "image") { return @tr("Images"); }
        if (key == "vector") { return @tr("Vector"); }
        if (key == "convert") { return @tr("Converters"); }
        if (key == "text") { return @tr("Text"); }
        if (key == "files") { return @tr("Files"); }
        if (key == "dev") { return @tr("Development"); }
        return key;
    }

    // Tool texts come from the tool itself in English; a tool gets a branch here
    // when it has a translation. `fallback` is the English text from the registry.
    pure public function tool-name(id: string, fallback: string) -> string {
        if (id == "convert.data") { return @tr("Data size"); }
        return fallback;
    }

    pure public function tool-description(id: string, fallback: string) -> string {
        if (id == "convert.data") { return @tr("Converts bits, bytes, SI units (kB = 1000 B) and IEC units (KiB = 1024 B)."); }
        return fallback;
    }

    pure public function param-label(tool: string, param: string, fallback: string) -> string {
        if (tool == "convert.data" && param == "value") { return @tr("Value"); }
        if (tool == "convert.data" && param == "from") { return @tr("From"); }
        if (tool == "convert.data" && param == "to") { return @tr("To"); }
        return fallback;
    }

    // Labels of choice options; options without a branch show their id.
    pure public function option-label(tool: string, param: string, option: string) -> string {
        if (tool == "convert.data" && (param == "from" || param == "to")) {
            if (option == "bit") { return @tr("bit"); }
            if (option == "B") { return @tr("B"); }
            if (option == "kbit") { return @tr("kbit"); }
            if (option == "Mbit") { return @tr("Mbit"); }
            if (option == "Gbit") { return @tr("Gbit"); }
            if (option == "kB") { return @tr("kB"); }
            if (option == "MB") { return @tr("MB"); }
            if (option == "GB") { return @tr("GB"); }
            if (option == "TB") { return @tr("TB"); }
            if (option == "KiB") { return @tr("KiB"); }
            if (option == "MiB") { return @tr("MiB"); }
            if (option == "GiB") { return @tr("GiB"); }
            if (option == "TiB") { return @tr("TiB"); }
        }
        return option;
    }

    pure public function range-hint(min: string, max: string) -> string {
        if (min != "" && max != "") { return @tr("{} to {}", min, max); }
        if (min != "") { return @tr("from {}", min); }
        if (max != "") { return @tr("up to {}", max); }
        return "";
    }

    // `arg` is the bound for below-min/above-max, and the raw (English) reason
    // from the core for any other code.
    pure public function field-error(code: string, arg: string) -> string {
        if (code == "whole-number") { return @tr("Enter a whole number"); }
        if (code == "number") { return @tr("Enter a number"); }
        if (code == "below-min") { return @tr("Must be at least {}", arg); }
        if (code == "above-max") { return @tr("Must be at most {}", arg); }
        if (code == "unexpected") { return @tr("Unexpected input"); }
        return arg;
    }

    pure public function result(kind: string, text: string) -> string {
        if (kind == "cancelled") { return @tr("Cancelled"); }
        if (kind == "empty") { return @tr("(empty result)"); }
        if (kind == "binary") { return @tr("The result is binary data; saving files is not implemented yet."); }
        return text;
    }
}
